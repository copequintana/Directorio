# Copia este archivo a .env (local) y define las mismas variables como
# Environment Variables del proyecto en Vercel para preview/producción.
# Ver docs/DEPLOYMENT.md para instrucciones paso a paso (Neon + Vercel).

# --- Base de datos (Neon) ---------------------------------------------------
# Cadena de conexión PUEDA (con "-pooler" en el host / pgbouncer=true).
# La usa la app en tiempo de ejecución (src/lib/db/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/directorio?sslmode=require"

# Cadena de conexión DIRECTA (sin "-pooler"). La usa el CLI de Prisma para
# migraciones (prisma migrate dev/deploy, prisma studio).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/directorio?sslmode=require"

# --- Autenticación (Auth.js / NextAuth) -------------------------------------
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="reemplaza-con-un-valor-aleatorio-largo"

# URL pública de la app. En Vercel se puede omitir (se infiere de VERCEL_URL),
# pero es obligatoria en local.
AUTH_URL="http://localhost:3000"
